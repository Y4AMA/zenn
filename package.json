{
  "name": "zenn",
  "version": "1.0.0",
  "description": "Zenn — refusal suppression for Claude Code. Hooks-based: doctrine inject, context reclaim, live stop-reclaim, self-learning. Install via curl.",
  "type": "module",
  "main": "cli.mjs",
  "bin": {
    "zenn": "./cli.mjs"
  },
  "scripts": {
    "install": "node install.mjs",
    "doctor": "node install.mjs --doctor",
    "uninstall": "node install.mjs --uninstall",
    "status": "node cli.mjs status",
    "genius": "node cli.mjs genius on"
  },
  "files": [
    "zenn-*.mjs",
    "hooks/",
    "cli.mjs",
    "install.mjs",
    "install.sh",
    "zenn.md",
    "zenn-coder.md",
    "zenn-prompter.md",
    "zenn-architect.md"
  ],
  "keywords": ["claude-code", "hooks", "zenn", "refusal-suppression"],
  "license": "MIT",
  "engines": { "node": ">=18" }
}
